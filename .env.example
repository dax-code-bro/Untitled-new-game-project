# Legend AI — Environment Variables
# Copy this to .env and fill in your keys. The .env file is gitignored,
# so your real keys never get committed or pushed to GitHub.

# Required: Atom — Legend's primary brain (Qwen 32B on OasisOS, OpenAI-compatible)
ATOM_API_KEY=sk-atom-your_key_here
ATOM_BASE_URL=https://oasisos.io/api/v1

# Optional failover: Claude AI (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional failover: ChatGPT (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: GitHub integration
GITHUB_TOKEN=your_github_token_here

# Optional: Image generation backend
# Options: stable_diffusion | dall_e | comfyui
IMAGE_BACKEND=stable_diffusion

# Optional: Local Stable Diffusion URL (if using SD)
SD_API_URL=http://localhost:7860

# Optional: ComfyUI URL
COMFYUI_URL=http://localhost:8188
