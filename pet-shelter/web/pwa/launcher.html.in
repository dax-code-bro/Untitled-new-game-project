<script>
// Launcher (the installed app's start page). githack keeps branch files cached for up to an hour,
// so the game itself is loaded from the newest *commit* of the branch (commit addresses are never
// stale). Offline, it uses the commit it loaded last time (the service worker has those files).
(async () => {
  const REPO = '@PS_REPO@', BRANCH = '@PS_BRANCH@', DIR = '@PS_APP_DIR@';
  const here = location.href.replace(/[^/]*([?#].*)?$/, '');            // this folder (branch copy)
  const onGithack = location.hostname === 'raw.githack.com';
  const status = (t) => { const el = document.getElementById('boot'); if (el) el.textContent = t; };
  if ('serviceWorker' in navigator && window.isSecureContext) navigator.serviceWorker.register('sw.js').catch(() => {});
  let sha = null;
  if (onGithack) {
    try {
      const ctl = new AbortController();
      setTimeout(() => ctl.abort(), 5000);
      const r = await fetch('https://api.github.com/repos/' + REPO + '/commits/' + encodeURIComponent(BRANCH),
                            { headers: { Accept: 'application/vnd.github.sha' }, cache: 'no-store', signal: ctl.signal });
      if (r.ok) { const t = (await r.text()).trim(); if (/^[0-9a-f]{40}$/.test(t)) sha = t; }
    } catch (e) { /* offline or GitHub busy */ }
    try {
      if (sha) localStorage.setItem('psSha', sha);
      else sha = localStorage.getItem('psSha');
    } catch (e) { /* storage unavailable */ }
  }
  const tries = [];
  if (sha) tries.push('https://raw.githack.com/' + REPO + '/' + sha + '/' + DIR + '/');
  tries.push(here);
  for (const base of tries) {
    try {
      const r = await fetch(base + 'game.html');
      if (!r.ok) continue;
      let html = await r.text();
      window.PS_SHA = base === here ? null : sha;          // the commit this copy came from (null = branch copy)
      window.PS_LAUNCH = { repo: REPO, branch: BRANCH, here: here };
      const info = '<script>window.PS_SHA=' + JSON.stringify(window.PS_SHA) + ';window.PS_LAUNCH=' + JSON.stringify(window.PS_LAUNCH) + ';<\/script>';
      html = html.replace('<head>', '<head><base href="' + base + '">' + info);
      document.open();
      document.write(html);
      document.close();
      return;
    } catch (e) { /* try the next copy */ }
  }
  status("Couldn't load the game. Check your connection and open it again.");
})();
</script>
<div id="boot" style="position:fixed;inset:0;display:grid;place-items:center;background:#0d1411;color:#d8e2dc;font:500 16px system-ui,sans-serif">Loading...</div>
</body>
</html>
