   "target_lufs": -25, "duck_db": 6,
   "layers": [
     { "noise": "pink", "seed": 1801, "stereo": true, "hp": 1100, "lp": 7500, "gain_db": -3, "env": "0.25+0.75*pow(0.5+0.5*sin(2*PI*t/5.3+0.9),2)*(0.6+0.4*sin(2*PI*t/1.9+0.3))" },
