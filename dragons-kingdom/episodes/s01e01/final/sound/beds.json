      "env": "0.75+0.15*sin(2*PI*t/0.73)+0.1*sin(2*PI*t/1.9+1)" },
    { "crackle": true, "seed": 771, "rate_hz": 2.2, "pan": -0.3, "hp": 1400, "lp": 6500, "gain_db": -6,
      "env_density": "pow(0.5+0.5*sin(2*PI*t/6.1),2)*1.6+0.2" }
