{
 "about": "Ambience beds for the episode mix (sound/mix.mjs). Every bed is SYNTHESISED here from seeded noise in FFmpeg (anoisesrc, aevalsrc): no recorded or downloaded sound, so no licence beyond the project's own. A bed = layers summed, then set to target_lufs (measured, integrated, as if heard alone) and ducked by duck_db under the dialogue. env = an FFmpeg expression in t (seconds on the cut timeline) multiplied into the layer, evaluated every 5 ms. Layer: noise (white|pink|brown) + seed, or crackle (sparse random impulses at rate_hz, density x env_density); filters hp/lp (Hz), bp [centre Hz, Q]; gain_db; stereo (two decorrelated seeds) or pan -1..1. Change a value and re-run the mixer: everything is re-made from this file.",
 "version": 1,
 "sets": {
  "CARD_BLACK": "sea_shore",
  "SEA_COAST_DAWN": "sea_open",
  "PROLOGUE_VISTAS": "vista_wind_sea",
  "VERDOR_GROUNDS": "grounds_wind",
  "BIRTHING_CHAMBER": "chamber_hush",
  "PALACE_CORRIDOR": "corridor_stone",
  "ALEXANDRIA_ROOM": "room_sea_window"
 },
 "shots": {},
 "default_bed": "chamber_hush",
 "crossfade_s": 0.5,
 "start_fade_s": 1.5,
 "beds": {
  "sea_shore": {
   "what": "Waves folding against a rocky shore, close: slow irregular swells with a foamy wash after each crest.",
   "target_lufs": -23, "duck_db": 6,
   "layers": [
    { "noise": "brown", "seed": 101, "stereo": true, "hp": 30, "lp": 420, "gain_db": 0,
      "env": "pow(0.5+0.32*sin(2*PI*t/7.9)+0.18*sin(2*PI*t/3.7+1.3),2)" },
    { "noise": "pink", "seed": 131, "stereo": true, "hp": 700, "lp": 5200, "gain_db": -9,
      "env": "pow(max(0,sin(2*PI*t/7.9-0.9)),3)*(0.7+0.3*sin(2*PI*t/1.9))+0.04" },
    { "noise": "pink", "seed": 151, "stereo": true, "hp": 2500, "lp": 9000, "gain_db": -24,
      "env": "pow(max(0,sin(2*PI*t/7.9-1.5)),6)" }
   ]
  },
  "sea_open": {
   "what": "Open water from low over the swell: broad wash, softer crests, no rocks.",
