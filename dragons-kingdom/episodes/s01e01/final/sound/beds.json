    { "noise": "pink", "seed": 231, "stereo": true, "hp": 500, "lp": 3800, "gain_db": -12,
      "env": "pow(0.5+0.5*sin(2*PI*t/9.3-0.8),2)*0.8+0.1" },
    { "noise": "pink", "seed": 251, "stereo": true, "hp": 150, "lp": 900, "gain_db": -18,
