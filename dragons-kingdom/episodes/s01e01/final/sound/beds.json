  "harbour_air": {
   "what": "(s9) X4 aerial over Verdor harbour / town / coast (VERDOR_AERIAL wired shots X4-01/02/03/11/14/20): flight air like flight_wind but a touch softer (cameras on camera ships, not on the riders), slow gusts, a faint high edge, and a far sea wash below (surf on the harbour wall and the coast). Gulls / bell / beats are SPOT effects. Synthesised noise only; different seeds from flight_wind so the 1C-19 -> X4-01 crossfade does not sum correlated noise.",
   "target_lufs": -22, "duck_db": 7,
   "layers": [
     { "noise": "brown", "seed": 1701, "stereo": true, "hp": 25, "lp": 300, "gain_db": 0, "env": "pow(0.7+0.2*sin(2*PI*t/7.9)+0.1*sin(2*PI*t/3.3+0.4),2)" },
     { "noise": "pink", "seed": 1721, "stereo": true, "bp": [700, 0.5], "gain_db": -6, "env": "0.35+0.65*pow(0.5+0.5*sin(2*PI*t/10.3+0.6),3)*(0.7+0.3*sin(2*PI*t/2.6))" },
     { "noise": "pink", "seed": 1741, "stereo": true, "bp": [2400, 1.5], "gain_db": -20, "env": "0.3+0.7*pow(0.5+0.5*sin(2*PI*t/10.3+0.3),4)" },
     { "noise": "brown", "seed": 1761, "stereo": true, "hp": 90, "lp": 700, "gain_db": -11, "env": "pow(max(0.15,0.55+0.45*sin(2*PI*t/6.1)+0.2*sin(2*PI*t/3.7+1.2)),2)" }
   ]
  },
  "terrace_farm": {
