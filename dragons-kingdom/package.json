{
  "name": "dragons-kingdom",
  "private": true,
  "version": "0.1.0",
  "description": "Dragons Kingdom - code-defined 3D scenes rendered to 4K video on CPU (three.js + headless Chromium + ffmpeg)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "render": "node render/render.mjs",
    "render:draft": "node render/render.mjs scenes/test-kingdom.js --preset draft",
    "render:preview": "node render/render.mjs scenes/test-kingdom.js --preset preview",
    "render:final": "node render/render.mjs scenes/test-kingdom.js --preset final",
    "render:final-fast": "node render/render.mjs scenes/test-kingdom.js --preset final-fast",
    "still": "node render/render.mjs --still scenes/test-kingdom.js --time 5 --preset final --png output/still-4k.png",
    "bench": "node render/bench.mjs --preset final",
    "bench:final-fast": "node render/bench.mjs --preset final-fast"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "optionalDependencies": {
    "playwright": "1.56.1"
  }
}
